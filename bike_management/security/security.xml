<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workshop Staff Group -->
    <record id="group_bike_workshop_staff" model="res.groups">
        <field name="name">Bike Workshop Staff</field>
    </record>

    <!-- Assign Administrator to Workshop Staff by default -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('bike_management.group_bike_workshop_staff'))]"/>
    </record>

    <record id="rule_bike_rental_portal_own" model="ir.rule">
	<field name="name">Portal Users: Own Rentals Only</field>
	<field name="model_id" ref="model_bike_rental"/>
	<field name="groups" eval="[(4, ref('base.group_portal'))]"/>
	<field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
	<field name="perm_read" eval="1"/>
	<field name="perm_write" eval="0"/>
	<field name="perm_create" eval="0"/>
	<field name="perm_unlink" eval="0"/>
    </record>

</odoo>
