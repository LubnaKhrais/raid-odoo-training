<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bike_repair_list" model="ir.ui.view">
        <field name="name">bike.repair.list</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_source"/>
                <field name="bike_id"/>
                <field name="mechanic_id"/>
		<field name="last_service_date"/>
                <field name="total_spare_parts_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <record id="view_bike_repair_form" model="ir.ui.view">
        <field name="name">bike.repair.form</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">

            <form string="Repair Job">

                <header>

                    <button name="action_start"
                            string="Start Repair"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ['draft', 'in_progress']"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_progress,completed,cancelled"/>

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="bike_source"/>
                            <field name="bike_id"
                                   invisible="bike_source != 'workshop'"/>
                        </group>

                        <group>
                            <field name="mechanic_id"/>
			    <field name="last_service_date"/>
                        </group>

                    </group>


                    <group string="External Bike Information"
                           invisible="bike_source != 'external'">

                        <field name="external_bike_reference"/>
                        <field name="external_bike_brand"/>
                        <field name="external_bike_type"/>

                    </group>


                    <group string="Repair Details">

                        <field name="reported_issue"/>

                    </group>


                    <notebook>

                        <page string="Spare Parts">

                            <field name="spare_part_line_ids">

                                <list editable="bottom">

                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>

                                </list>

                            </field>

                            <group>

                                <field name="total_spare_parts_cost"/>

                            </group>

                        </page>


                        <page string="Service Information">

                            <field name="service_notes"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <record id="action_bike_repair" model="ir.actions.act_window">

        <field name="name">Repair Jobs</field>
        <field name="res_model">bike.repair</field>
        <field name="view_mode">list,form</field>

    </record>


    <menuitem id="menu_bike_repair_root"
              name="Repair Management"
	      parent="bike_management.menu_bike_root"
	      groups="bike_management.group_bike_workshop_staff"
              sequence="20"/>

    <menuitem id="menu_bike_repair"
              name="Repair Jobs"
              parent="menu_bike_repair_root"
              action="action_bike_repair"
              sequence="10"/>

</odoo>
