<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bike List View -->
    <record id="view_bike_list" model="ir.ui.view">
        <field name="name">bike.management.bike.list</field>
        <field name="model">bike.management.bike</field>
        <field name="arch" type="xml">
            <list string="Bikes">
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="purchase_date"/>
                <field name="last_maintenance_date"/>
                <field name="daily_rental_price"/>
                <field name="wheel_size"/>
                <field name="rental_count"/>
            </list>
        </field>
    </record>

    <!-- Bike Form View -->
    <record id="view_bike_form" model="ir.ui.view">
        <field name="name">bike.management.bike.form</field>
        <field name="model">bike.management.bike</field>
        <field name="arch" type="xml">
            <form string="Bike">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rentals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-motorcycle">
                            <field name="rental_count"
                                   widget="statinfo"
                                   string="Rentals"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="bike_type"/>
                            <field name="wheel_size"/>
                        </group>

                        <group>
                            <field name="purchase_date"/>
                            <field name="last_maintenance_date"/>
                            <field name="daily_rental_price"/>
                            <field name="rental_count"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Bike Action -->
    <record id="action_bike_management_bike" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.management.bike</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
