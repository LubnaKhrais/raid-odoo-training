<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rental List View -->
    <record id="view_bike_rental_list" model="ir.ui.view">
        <field name="name">bike.rental.list</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="start_date"/>
                <field name="expected_return_date"/>
                <field name="actual_return_date"/>
                <field name="daily_price"/>
                <field name="rental_duration"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- Rental Search View -->
    <record id="view_bike_rental_search" model="ir.ui.view">
        <field name="name">bike.rental.search</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <search string="Rentals">

                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="bike_type"/>
                <field name="start_date"/>
                <field name="expected_return_date"/>
                <field name="state"/>
                <field name="return_performance"/>

                <separator/>

                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />

                <filter
                    name="filter_confirmed"
                    string="Confirmed"
                    domain="[('state', '=', 'confirmed')]"
                />

                <filter
                    name="filter_returned"
                    string="Returned"
                    domain="[('state', '=', 'returned')]"
                />

                <filter
                    name="filter_on_time"
                    string="On Time"
                    domain="[('return_performance', '=', 'on_time')]"
                />

                <filter
                    name="filter_late"
                    string="Late"
                    domain="[('return_performance', '=', 'late')]"
                />

                <filter
                    name="filter_pending"
                    string="Pending"
                    domain="[('return_performance', '=', 'pending')]"
                />

                <separator/>

                <group>

                    <filter
                        name="group_by_bike_type"
                        string="Bike Type"
                        context="{'group_by': 'bike_type'}"
                    />

                    <filter
                        name="group_by_status"
                        string="Rental Status"
                        context="{'group_by': 'state'}"
                    />

                    <filter
                        name="group_by_customer"
                        string="Customer"
                        context="{'group_by': 'customer_id'}"
                    />

                    <filter
                        name="group_by_return_performance"
                        string="Return Performance"
                        context="{'group_by': 'return_performance'}"
                    />

                    <filter
                        name="group_by_month"
                        string="Rental Month"
                        context="{'group_by': 'start_date:month'}"
                    />

                </group>

            </search>
        </field>
    </record>


    <!-- Rental Form View -->
    <record id="view_bike_rental_form" model="ir.ui.view">
        <field name="name">bike.rental.form</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <form string="Bike Rental">

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_return"
                        string="Return"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'confirmed'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,returned"
                    />

                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="bike_id"/>
                        </group>

                        <group>
                            <field name="start_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date"/>
                        </group>
                    </group>

                    <group string="Rental Calculation">
                        <field name="daily_price"/>
                        <field name="rental_duration"/>
                        <field name="total_amount"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- All Rentals Action -->
    <record id="action_all_bike_rentals" model="ir.actions.act_window">
        <field name="name">All Rentals</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bike_rental_search"/>
    </record>


    <!-- Confirmed Rentals Action -->
    <record id="action_confirmed_bike_rentals" model="ir.actions.act_window">
        <field name="name">Confirmed Rentals</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="search_view_id" ref="view_bike_rental_search"/>
    </record>


    <!-- Rental Management Menu -->
    <menuitem
        id="menu_bike_rental_root"
        name="Rental Management"
        parent="bike_management.menu_bike_root"
        groups="bike_management.group_bike_workshop_staff"
        sequence="15"
    />

    <menuitem
        id="menu_confirmed_bike_rentals"
        name="Confirmed Rentals"
        parent="menu_bike_rental_root"
        action="action_confirmed_bike_rentals"
        sequence="10"
    />

    <menuitem
        id="menu_all_bike_rentals"
        name="All Rentals"
        parent="menu_bike_rental_root"
        action="action_all_bike_rentals"
        sequence="20"
    />

</odoo>
