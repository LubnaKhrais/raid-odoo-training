<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="web_layout_rtl"
        inherit_id="web.layout"
        name="Bike Management RTL Web Layout">

        <xpath expr="//html" position="attributes">
            <attribute name="t-att-dir">
                request.env['res.lang']._get_data(
                    code=request.env.lang
                ).direction
            </attribute>

            <attribute name="t-att-lang">
                request.env.lang
            </attribute>
        </xpath>

    </template>

</odoo>
