<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_bike_management" model="ir.ui.view">
        <field name="name">res.partner.form.bike.management</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="preferred_bike_type"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Rental History">
                    <field name="rental_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="bike_id"/>
                            <field name="start_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date"/>
                            <field name="state"/>
                            <field name="total_amount"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
