<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bike_workshop_dashboard_form" model="ir.ui.view">
        <field name="name">bike.workshop.dashboard.form</field>
        <field name="model">bike.workshop.dashboard</field>
        <field name="arch" type="xml">
            <form string="Workshop Dashboard">
                <sheet>
                    <div class="oe_title">
                        <h1>Bike Workshop Operations Dashboard</h1>
                    </div>

                    <div class="row mt16">

                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h3>Active Rentals Today</h3>
                                    <field name="active_rentals_today"
                                           nolabel="1"
                                           class="display-4"/>
                                    <br/>
                                    <button name="action_view_active_rentals"
                                            type="object"
                                            string="View Rentals"
                                            class="btn btn-primary mt8"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h3>Returns Due Today</h3>
                                    <field name="returns_due_today"
                                           nolabel="1"
                                           class="display-4"/>
                                    <br/>
                                    <button name="action_view_returns_due"
                                            type="object"
                                            string="View Returns"
                                            class="btn btn-primary mt8"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h3>Repairs In Progress</h3>
                                    <field name="repairs_in_progress"
                                           nolabel="1"
                                           class="display-4"/>
                                    <br/>
                                    <button name="action_view_repairs_in_progress"
                                            type="object"
                                            string="View Repairs"
                                            class="btn btn-primary mt8"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bike_workshop_dashboard" model="ir.actions.act_window">
        <field name="name">Workshop Dashboard</field>
        <field name="res_model">bike.workshop.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_bike_workshop_dashboard"
        name="Workshop Dashboard"
	parent="menu_bike_root"
        action="action_bike_workshop_dashboard"/>

</odoo>
